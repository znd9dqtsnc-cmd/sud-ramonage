---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { company } from '../data/company.js';
const {title = 'SUD RAMONAGE — Artisan ramoneur diplômé COSTIC', description = 'Ramonage, débistrage et diagnostics à Martigues, Côte Bleue et Bouches-du-Rhône.', image = '/hero-provence.webp', schema = []} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const business = {'@context':'https://schema.org','@type':'LocalBusiness',name:company.name,description:company.tagline,url:'https://sud-ramonage.com',telephone:'+33664729600',email:company.email,address:{'@type':'PostalAddress',streetAddress:'31 Chemin des Tamaris',postalCode:'13500',addressLocality:'Martigues',addressCountry:'FR'},areaServed:['Martigues','Côte Bleue','Étang de Berre','Bouches-du-Rhône'],priceRange:'€€'};
const schemas = [business, ...schema];
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><link rel="icon" href="/favicon.svg"/><link rel="canonical" href={canonical}/><title>{title}</title><meta name="description" content={description}/><meta name="robots" content="index,follow"/><meta property="og:type" content="website"/><meta property="og:locale" content="fr_FR"/><meta property="og:site_name" content="SUD RAMONAGE"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(image, Astro.site)}/><meta name="theme-color" content="#07111d"/>{schemas.map(item=><script type="application/ld+json" set:html={JSON.stringify(item)} />)}</head><body><header class="site-header"><div class="shell nav"><a class="brand" href="/" aria-label="SUD RAMONAGE, accueil"><span class="brand-mark"><Icon name="home" size={19}/></span><span>SUD RAMONAGE<small>ARTISAN RAMONEUR DIPLÔMÉ</small></span></a><nav id="main-nav" aria-label="Navigation principale"><a href="/prestations/">Nos services</a><a href="/zones-intervention/">Zones d’intervention</a><a href="/conseils/">Conseils & blog</a><a href="/a-propos/">À propos</a><a href="/contact/">Contact</a></nav><a class="call-top" href={company.phoneHref}><Icon name="phone" size={15}/><span><b>{company.phone}</b><small>Appel direct · réponse rapide</small></span></a><button class="menu-toggle" aria-label="Ouvrir le menu" aria-controls="main-nav" aria-expanded="false"><Icon name="menu" size={22}/></button></div></header><main><slot /></main><footer class="site-footer"><div class="shell footer-grid"><div><a class="brand" href="/"><span class="brand-mark"><Icon name="home" size={19}/></span><span>SUD RAMONAGE<small>ARTISAN RAMONEUR DIPLÔMÉ</small></span></a><p>Ramonage, débistrage et diagnostics à Martigues, sur la Côte Bleue et dans les Bouches-du-Rhône.</p></div><div><h2>Accès rapide</h2><a href="/prestations/">Prestations</a><a href="/tarifs/">Tarifs</a><a href="/zones-intervention/">Zones d’intervention</a><a href="/contact/">Contact</a></div><div><h2>Contact</h2><a href={company.phoneHref}>{company.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a><p>{company.hours}</p></div></div><div class="shell footer-bottom">© {new Date().getFullYear()} SUD RAMONAGE · <a href="/mentions-legales/">Mentions légales</a> · <a href="/cgv/">CGV</a> · <a href="/confidentialite/">Confidentialité</a> · <a href="/retractation/">Rétractation</a></div></footer><a class="mobile-call" href={company.phoneHref}><Icon name="phone" size={17}/> Appeler SUD RAMONAGE</a><script is:inline>const b=document.querySelector('.menu-toggle'),n=document.querySelector('.nav');b?.addEventListener('click',()=>{const x=n.classList.toggle('menu-open');b.setAttribute('aria-expanded',x);b.setAttribute('aria-label',x?'Fermer le menu':'Ouvrir le menu')})</script></body></html>
