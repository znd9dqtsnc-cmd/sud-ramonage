---
import BaseLayout from '../layouts/BaseLayout.astro'; import Cta from '../components/Cta.astro'; import Icon from '../components/Icon.astro'; import {company,services} from '../data/company.js';
const topServices=services.slice(0,6);
---
<BaseLayout title="SUD RAMONAGE | Artisan ramoneur diplômé à Martigues" description="Ramonage, débistrage et diagnostics à Martigues, Côte Bleue et Étang de Berre. Artisan ramoneur diplômé COSTIC.">
<section class="hero"><img src="/hero-provence.webp" width="1536" height="1024" alt="Illustration d’un artisan ramoneur au coucher du soleil en Provence" fetchpriority="high" decoding="async"/><div class="hero-shade"></div><div class="shell hero-content"><p class="eyebrow">SÉCURITÉ · CONFORT · SÉRÉNITÉ</p><h1>Votre expert du ramonage <em>en Provence</em></h1><p class="lead">SUD RAMONAGE, artisan ramoneur diplômé COSTIC, intervient à Martigues, sur la Côte Bleue, autour de l’Étang de Berre et dans les Bouches-du-Rhône.</p><div class="hero-points"><span><Icon name="shield" size={16}/> Artisan diplômé</span><span><Icon name="clock" size={16}/> Intervention de 7 h à 21 h</span><span><Icon name="document" size={16}/> Devis sur demande</span><span><Icon name="spark" size={16}/> Conseils personnalisés</span></div><div class="cta-actions"><a class="button gold" href={company.phoneHref}><Icon name="phone" size={17}/> {company.phone}</a><a class="button outline" href="/contact/">Demander un devis <Icon name="arrow" size={16}/></a></div></div><aside class="hero-asides"><span><Icon name="document" size={16}/> Certificat de ramonage selon prestation</span><span><Icon name="shield" size={16}/> Intervention expliquée avant engagement</span><span><Icon name="map" size={16}/> Particuliers & professionnels</span></aside></section>
<section class="section cream"><div class="shell"><p class="eyebrow dark-text">PRESTATIONS</p><h2>Nos services de ramonage</h2><p class="section-intro">Des prestations adaptées à votre installation, avec un périmètre clair avant toute intervention.</p><div class="service-grid">{topServices.map(s=><a class="service-card" href={`/prestations/${s.slug}/`}><span class="service-icon"><Icon name={s.icon} size={25}/></span><h3>{s.title}</h3><p>{s.short}</p><b>{s.price}</b><span class="arrow">En savoir plus <Icon name="arrow" size={14}/></span></a>)}</div><p class="section-link"><a href="/prestations/">Voir toutes les prestations <Icon name="arrow" size={16}/></a></p></div></section>
<section class="territory"><div class="shell territory-grid"><div><p class="eyebrow">INTERVENTIONS</p><h2>Dans les Bouches-du-Rhône et autour de Martigues</h2><p>Un service de proximité pour les particuliers, professionnels, syndics et collectivités. Vérifiez votre secteur avant toute prise de rendez-vous.</p><a class="button outline" href="/zones-intervention/">Voir les zones d’intervention <Icon name="arrow" size={16}/></a></div><div class="map-art" aria-label="Carte stylisée des principales zones d’intervention"><span class="map-dot martigues">Martigues</span><span class="map-dot marseille">Marseille Ouest</span><span class="map-dot aix">Aix-en-Provence</span><span class="map-dot istres">Istres</span><span class="map-dot vitrolles">Vitrolles</span></div></div></section>
<section class="section cream why"><div class="shell why-grid"><div><p class="eyebrow dark-text">L’ESSENTIEL</p><h2>Une prestation claire, de la demande au certificat</h2><p>Un interlocuteur unique, des prestations expliquées avec précision et une attention particulière portée à la sécurité de vos conduits.</p><ul><li><Icon name="check" size={16}/> Artisan ramoneur diplômé COSTIC</li><li><Icon name="check" size={16}/> Interventions de 7 h à 21 h</li><li><Icon name="check" size={16}/> Conseils adaptés à votre installation</li><li><Icon name="check" size={16}/> Certificat de ramonage selon prestation</li><li><Icon name="check" size={16}/> Particuliers et professionnels</li></ul></div><div class="assurance-card"><span><Icon name="shield" size={30}/></span><h3>Avant d’intervenir, nous clarifions l’essentiel.</h3><p>Le tarif, le périmètre de la prestation et les éventuelles contraintes sont présentés avant l’engagement lorsque cela est nécessaire.</p><a href="/a-propos/">Découvrir l’entreprise <Icon name="arrow" size={15}/></a></div></div></section>
<Cta dark />
</BaseLayout>
