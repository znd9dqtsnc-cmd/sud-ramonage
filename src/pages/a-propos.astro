---
import BaseLayout from '../layouts/BaseLayout.astro'; import Cta from '../components/Cta.astro'; import Icon from '../components/Icon.astro'; import {company} from '../data/company.js';
---
<BaseLayout title="À propos | SUD RAMONAGE" description="Découvrez SUD RAMONAGE, artisan ramoneur diplômé COSTIC basé à Martigues."><section class="page-hero"><div class="shell"><p class="eyebrow">L’ENTREPRISE</p><h1>Un artisan ramoneur à votre écoute</h1><p>SUD RAMONAGE accompagne particuliers et professionnels pour l’entretien et le diagnostic de leurs conduits.</p></div></section><section class="section cream"><div class="shell split"><article><h2>SUD RAMONAGE</h2><p>{company.owner}, artisan ramoneur diplômé COSTIC, intervient depuis Martigues sur la Côte Bleue, autour de l’Étang de Berre et dans les secteurs pertinents des Bouches-du-Rhône.</p><p>Chaque intervention commence par l’écoute de votre besoin et la prise en compte de votre installation. Les limites de prestation sont exposées clairement lorsque nécessaire.</p><h2>Nos engagements de clarté</h2><ul><li><Icon name="check" size={16}/>Prestations et tarifs expliqués avant engagement</li><li><Icon name="check" size={16}/>Conseils adaptés à la configuration indiquée</li><li><Icon name="check" size={16}/>Responsabilité civile professionnelle MAIF</li><li><Icon name="check" size={16}/>Interventions communiquées de 7 h à 21 h</li></ul></article><aside class="quote-panel"><span><Icon name="home" size={31}/></span><h2>Basé à Martigues</h2><p>{company.address}</p><a class="button gold" href="/contact/">Contacter SUD RAMONAGE <Icon name="arrow" size={16}/></a></aside></div></section><Cta dark /></BaseLayout>
