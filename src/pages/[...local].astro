---
import BaseLayout from '../layouts/BaseLayout.astro'; import Cta from '../components/Cta.astro'; import Icon from '../components/Icon.astro'; import {localPages} from '../data/company.js';
export function getStaticPaths(){return Object.entries(localPages).map(([slug,p])=>({params:{local:`ramonage-${slug}`},props:{place:p,slug}}))}; const {place,slug}=Astro.props;
const martigues=slug==='martigues'; const schema=[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Accueil',item:'https://sud-ramonage.com/'},{'@type':'ListItem',position:2,name:'Zones d’intervention',item:'https://sud-ramonage.com/zones-intervention/'},{'@type':'ListItem',position:3,name:place.name}]}];
---
<BaseLayout title={`${place.title} | SUD RAMONAGE`} description={`${place.title}. Ramonage, débistrage et diagnostics selon votre installation.`} schema={schema}><section class="page-hero"><div class="shell"><p class="eyebrow">ZONE D’INTERVENTION</p><p class="breadcrumb"><a href="/">Accueil</a> / <a href="/zones-intervention/">Zones</a> / {place.name}</p><h1>{place.title}</h1><p>{place.intro}</p></div></section><section class="section cream"><div class="shell split"><article><h2>{martigues ? 'Votre artisan ramoneur basé à Martigues' : 'Intervention dans votre secteur'}</h2>{martigues ? <><p>SUD RAMONAGE est établi au 31 Chemin des Tamaris, 13500 Martigues. Cette implantation constitue le point de départ naturel des demandes locales, qu’il s’agisse d’un ramonage de cheminée, d’un poêle à bois ou à granulés, d’un débistrage ou d’un diagnostic de conduit.</p><p>La demande est précisée selon l’appareil, le conduit, l’accès et l’objectif recherché afin de distinguer ramonage, inspection caméra, contrôle de vacuité ou prestation plus technique.</p></> : <><p>{place.places}</p><p>{place.focus || 'SUD RAMONAGE est basé à Martigues. Les demandes sont organisées selon le secteur, le type d’équipement et les conditions d’accès afin de proposer une intervention cohérente.'}</p></>}<h2>Prestations utiles dans votre situation</h2><ul><li><Icon name="flame" size={16}/>Ramonage de poêle à bois, insert ou cheminée</li><li><Icon name="flame" size={16}/>Ramonage de poêle à granulés / pellets</li><li><Icon name="shield" size={16}/>Débistrage après évaluation technique</li><li><Icon name="camera" size={16}/>Contrôle de vacuité et inspection caméra</li></ul></article><aside class="quote-panel"><span><Icon name="map" size={31}/></span><h2>{martigues ? 'Martigues, notre base' : 'Vous êtes dans cette zone ?'}</h2><p>Contactez-nous afin de vérifier le secteur, la prestation et les conditions d’intervention.</p><a class="button gold" href="/contact/">Vérifier ma zone <Icon name="arrow" size={16}/></a></aside></div></section>{(martigues || place.focus) && <section class="section"><div class="shell narrow"><p class="eyebrow dark-text">REPÈRES UTILES</p><h2>{martigues ? 'Ramonage et diagnostics à Martigues : bien choisir votre besoin' : `Préparer votre demande à ${place.name}`}</h2><p>Pour un poêle à granulés, le ramonage du conduit à 75 € et l’entretien annuel complet avec ramonage à 190 € sont deux prestations distinctes. Pour une cheminée ou un poêle à bois, le besoin dépend de l’équipement et du conduit. En cas de doute sur la vacuité, le tirage ou l’état intérieur, une prestation de diagnostic peut être plus appropriée qu’un simple ramonage.</p><div class="local-links"><a href="/prestations/poele-granules/">Poêle à granulés</a><a href="/prestations/debistrage/">Débistrage</a><a href="/prestations/inspection-camera/">Inspection caméra</a><a href="/tarifs/">Voir les tarifs</a></div></div></section>}<Cta dark /></BaseLayout>
