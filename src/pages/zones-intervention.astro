---
import BaseLayout from '../layouts/BaseLayout.astro'; import Cta from '../components/Cta.astro'; import Icon from '../components/Icon.astro'; import {localPages} from '../data/company.js';
---
<BaseLayout title="Zones d’intervention | SUD RAMONAGE" description="SUD RAMONAGE intervient à Martigues, sur la Côte Bleue, autour de l’Étang de Berre et dans les Bouches-du-Rhône."><section class="page-hero"><div class="shell"><p class="eyebrow">PROXIMITÉ</p><h1>Zones d’intervention</h1><p>Martigues, Côte Bleue, Étang de Berre, Marseille Ouest et secteurs pertinents des Bouches-du-Rhône.</p></div></section><section class="territory zones"><div class="shell territory-grid"><div><h2>Vérifier votre zone</h2><p>Le secteur desservi et les conditions d’intervention sont confirmés au moment de la demande. Cela permet de vous donner une réponse précise.</p><a class="button gold" href="/contact/">Vérifier ma zone <Icon name="arrow" size={16}/></a></div><div class="map-art big" aria-label="Carte stylisée des principales zones d’intervention"><span class="map-dot martigues">Martigues</span><span class="map-dot marseille">Marseille Ouest</span><span class="map-dot aix">Aix-en-Provence</span><span class="map-dot istres">Istres</span></div></div></section><section class="section cream"><div class="shell"><h2>Nos secteurs principaux</h2><div class="local-grid">{Object.entries(localPages).map(([slug,p])=><a href={`/ramonage-${slug}/`}><span><Icon name="map" size={25}/></span><h3>{p.name}</h3><p>{p.places}</p><b>Découvrir <Icon name="arrow" size={14}/></b></a>)}</div></div></section><Cta dark /></BaseLayout>
