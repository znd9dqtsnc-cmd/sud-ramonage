---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Cta from '../../components/Cta.astro'; import Icon from '../../components/Icon.astro'; import {services} from '../../data/company.js';
export function getStaticPaths(){return services.map(s=>({params:{slug:s.slug},props:{service:s}}))}; const {service}=Astro.props;
const copy={
ramonage:{need:'Le ramonage répond au besoin d’entretien d’un conduit de fumée associé à une cheminée, un insert, un poêle ou certains équipements de chauffage.', included:['Préparation de l’intervention selon l’accès','Nettoyage du conduit concerné','Information sur les constats visibles lors de la prestation'], signs:['Entretien périodique à organiser','Changement d’occupant ou dossier de location','Question sur l’état apparent du conduit'], near:'Le ramonage ne remplace pas un diagnostic approfondi ni un débistrage lorsque les dépôts ou la situation le justifient.'},
'poele-bois':{need:'Cette prestation concerne le conduit associé à votre poêle à bois. Elle est étudiée selon votre appareil et la configuration des lieux.',included:['Ramonage du conduit concerné','Vérification des conditions d’accès','Conseils d’usage et d’entretien adaptés'],signs:['Période de chauffe à préparer','Besoin d’un certificat selon la prestation','Doute sur le fonctionnement ou le tirage'],near:'Une inspection caméra ou un diagnostic peut être pertinent si un doute persiste sur le conduit.'},
'poele-granules':{need:'Le poêle à granulés demande de distinguer clairement le ramonage du conduit de l’entretien complet de l’appareil.',included:['Ramonage du conduit pour la formule à 75 €','Ou entretien annuel complet avec ramonage à 190 €','Explication du périmètre retenu avant intervention'],signs:['Entretien annuel de l’appareil à programmer','Conduit à faire ramoner','Baisse de performance ou question sur le fonctionnement'],near:'Le ramonage à 75 € concerne le conduit. L’entretien annuel complet + ramonage à 190 € comprend une prestation plus étendue sur l’appareil et son conduit : les deux ne doivent pas être confondus.'},
insert:{need:'Le ramonage d’un insert concerne le conduit d’évacuation des fumées de votre foyer fermé.',included:['Ramonage du conduit concerné','Prise en compte de l’accès à l’installation','Conseils adaptés à l’équipement indiqué'],signs:['Entretien à programmer avant la saison de chauffe','Doute sur le conduit ou son tirage','Besoin d’un contrôle complémentaire'],near:'Un problème de tirage ou un doute sur l’intérieur du conduit peut relever d’un diagnostic ou d’une inspection caméra.'},
'cheminee-foyer-ouvert':{need:'Le ramonage d’une cheminée à foyer ouvert est étudié selon le conduit, l’accès et l’état apparent de l’installation.',included:['Ramonage du conduit de cheminée','Échange préalable sur l’installation','Information sur la prestation réalisée'],signs:['Préparation de la saison de chauffe','Nuisances ou fumées anormales','Besoin d’évaluer l’état du conduit'],near:'Une cheminée à foyer ouvert ne relève pas automatiquement d’un débistrage ou d’une inspection caméra : le besoin est défini après échange.'},
debistrage:{need:'Le débistrage répond à la présence suspectée ou constatée de dépôts de bistre durcis dans un conduit.',included:['Évaluation préalable de la situation','Prestation technique si elle est adaptée','Explication du périmètre et du tarif avant engagement'],signs:['Dépôt goudronné ou durci visible','Doute après un ramonage classique','Question de sécurité liée au conduit'],near:'Un débistrage n’est pas un simple ramonage. Il est proposé après évaluation technique et son tarif débute à 390 €.'},
'inspection-camera':{need:'L’inspection caméra permet d’examiner l’intérieur d’un conduit lorsque la configuration technique le permet.',included:['Passage caméra selon faisabilité','Constats visuels utiles à la demande','Rapport et photos à partir de 110 €'],signs:['Doute sur l’état intérieur du conduit','Question avant remise en service','Besoin de localiser une anomalie visible'],near:'L’inspection caméra complète utilement le ramonage mais ne le remplace pas. Elle est distincte du contrôle de vacuité et du test fumigène.'},
diagnostics:{need:'Les diagnostics permettent de répondre à une question précise sur un conduit ou le comportement d’une installation.',included:['Choix du contrôle correspondant au besoin','Vacuité, fumigène ou diagnostic de refoulement selon cas','Restitution des constats liés à la prestation'],signs:['Doute sur la vacuité du conduit','Refoulement ou comportement inhabituel','Projet de remise en service'],near:'Chaque diagnostic a un objectif propre : contrôle de vacuité à 90 €, test fumigène à 90 €, diagnostic de refoulement à 250 € ou étude technique selon le cas.'},
chaudieres:{need:'Les besoins liés aux chaudières sont étudiés selon l’énergie et le type d’équipement concerné.',included:['Ramonage chaudière murale gaz : 75 €','Ramonage + nettoyage chaudière fioul / bois : 110 €','Périmètre expliqué avant intervention'],signs:['Entretien à planifier','Question sur un conduit de chaudière','Besoin de distinguer ramonage et entretien réglementaire'],near:'Le ramonage ne doit pas être confondu avec l’entretien réglementaire complet d’un appareil lorsque ces prestations sont techniquement ou juridiquement distinctes.'},
professionnels:{need:'SUD RAMONAGE accompagne les syndics, agences immobilières et métiers de bouche dans le cadre des prestations effectivement proposées.',included:['Échange sur l’installation et le besoin','Organisation selon les contraintes du site','Documents ou attestations selon la prestation'],signs:['Préparation d’une vente ou location','Entretien d’un conduit professionnel','Besoin de planifier une intervention'],near:'Les fours à bois et professionnels sont étudiés sur devis. Les activités de pose ou remplacement de conduits restent indiquées comme prochainement.'}
}[service.slug];
const schema=[{'@context':'https://schema.org','@type':'Service',name:service.title,description:service.short,provider:{'@type':'LocalBusiness',name:'SUD RAMONAGE'},areaServed:'Bouches-du-Rhône'},{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Accueil',item:'https://sud-ramonage.com/'},{'@type':'ListItem',position:2,name:'Prestations',item:'https://sud-ramonage.com/prestations/'},{'@type':'ListItem',position:3,name:service.title}]}];
---
<BaseLayout title={`${service.title} | SUD RAMONAGE`} description={`${service.short} Intervention à Martigues, Côte Bleue et Bouches-du-Rhône.`} schema={schema}><section class="page-hero"><div class="shell"><p class="eyebrow">PRESTATION</p><p class="breadcrumb"><a href="/">Accueil</a> / <a href="/prestations/">Prestations</a> / {service.title}</p><h1>{service.title}</h1><p>{service.short}</p></div></section><section class="section cream"><div class="shell split"><article><h2>À qui cette prestation s’adresse-t-elle ?</h2><p>{copy.need}</p><h2>Ce qui est pris en compte</h2><ul>{copy.included.map(i=><li><Icon name="check" size={16}/>{i}</li>)}</ul><h2>Quand nous contacter ?</h2><ul>{copy.signs.map(i=><li><Icon name="check" size={16}/>{i}</li>)}</ul></article><aside class="quote-panel"><span><Icon name={service.icon} size={31}/></span><h2>{service.price}</h2><p>Tarif indicatif ou de départ selon la prestation. Les éventuels frais, contraintes ou suppléments sont communiqués avant engagement.</p><a class="button gold" href="/contact/">Demander un devis <Icon name="arrow" size={16}/></a><a class="text-link" href="/tarifs/">Consulter les tarifs <Icon name="arrow" size={14}/></a></aside></div></section><section class="section"><div class="shell narrow"><p class="eyebrow dark-text">BIEN DISTINGUER LES PRESTATIONS</p><h2>Ce que cette prestation ne remplace pas</h2><p>{copy.near}</p><div class="notice"><b>Zones concernées.</b> SUD RAMONAGE intervient depuis Martigues, sur la Côte Bleue, autour de l’Étang de Berre et dans les secteurs pertinents des Bouches-du-Rhône. <a href="/zones-intervention/">Vérifier votre zone</a>.</div></div></section><section class="section cream"><div class="shell narrow"><h2>Questions fréquentes</h2><details><summary>Le tarif est-il toujours identique ?</summary><p>Le tarif publié s’applique à la prestation indiquée. Lorsque la situation implique une étude, un accès particulier, de la distance ou une configuration spécifique, le montant est clarifié avant engagement.</p></details><details><summary>Un certificat est-il remis ?</summary><p>Un certificat de ramonage peut être remis selon la prestation réalisée. N’hésitez pas à préciser votre besoin lors de la demande.</p></details><details><summary>Proposez-vous le tubage ou le remplacement de conduits ?</summary><p>Ces prestations ne sont pas proposées actuellement. Elles restent indiquées comme prochainement jusqu’à validation d’une couverture d’assurance appropriée.</p></details></div></section><Cta dark title={`Parlons de votre ${service.title.toLowerCase()}`} /></BaseLayout>
