---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Cta from '../../components/Cta.astro'; import {services,priceGroups} from '../../data/company.js';
---
<BaseLayout title="Prestations de ramonage | SUD RAMONAGE" description="Découvrez les prestations de ramonage, débistrage, diagnostics et entretien proposées par SUD RAMONAGE."><section class="page-hero"><div class="shell"><p class="eyebrow">NOS SERVICES</p><h1>Des prestations adaptées à votre installation</h1><p>Chaque demande est étudiée selon l’appareil, le conduit et les conditions d’accès.</p></div></section><section class="section cream"><div class="shell"><div class="service-grid">{services.map(s=><a class="service-card" href={`/prestations/${s.slug}/`}><span class="service-icon">{s.icon}</span><h2>{s.title}</h2><p>{s.short}</p><b>{s.price}</b><span class="arrow">Découvrir →</span></a>)}</div></div></section><section class="section"><div class="shell"><h2>Repères tarifaires</h2><div class="price-grid">{priceGroups.map(g=><div class="price-box"><h3>{g.title}</h3>{g.items.slice(0,3).map(i=><p><span>{i[0]}</span><b>{i[1]}</b></p>)}<a href="/tarifs/">Voir tous les tarifs →</a></div>)}</div></div></section><Cta dark /></BaseLayout>
